# Base URL API (в dev можно оставить /api — проксируется через Vite)
VITE_API_BASE_URL=/api

# Цель прокси для локальной разработки (см. vite.config.ts)
VITE_API_PROXY_TARGET=http://crm.public.lan

# Отдельный login франшизы (не /login_user сайта/CRM)
VITE_LOGIN_PATH=/franchising/auth/login

# Опционально: ссылка «войти на главной» сайта
# VITE_EXTERNAL_LOGIN_URL=http://www.public.lan/
