# Публичный путь SPA (prod: https://podzamenu.ru/crm_fr, LAN: http://public.lan/crm_fr)
VITE_APP_BASE_PATH=/crm_fr

# Same-origin API gateway (проксируется на бэкенд)
VITE_API_BASE_URL=/crm_fr/api

# Единый бэкенд: backend_7x
# LAN: http://back.public.lan · prod: https://back.podzamenu.ru
VITE_API_PROXY_TARGET=http://back.public.lan

# Публичный сайт с раздачей фото `/image/{id}.jpg`
VITE_SITE_HOST=http://public.lan

# Отдельный login франшизы (не /login_user сайта/CRM)
# Относительно /crm_fr/api/franchising
VITE_LOGIN_PATH=/auth/login

# Опционально: ссылка «войти на главной» сайта
# VITE_EXTERNAL_LOGIN_URL=http://public.lan/
